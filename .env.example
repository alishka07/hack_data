# Reference only: the Python launchers do not load .env files.
# Windows NVIDIA laptops: python scripts/bootstrap_local.py
# Other platforms: python scripts/bootstrap_local.py --llama-server /path/to/llama-server
# Then: python scripts/run_portable.py
# The bootstrap writes actual local paths to ignored data/local-runtime.json.
# Set shell environment variables to override those defaults.
FORTE_PORT=8000
FORTE_LLM_URL=http://127.0.0.1:18080
FORTE_VLM_BACKEND=llama.cpp
FORTE_ATTACH_MODEL=0
FORTE_VLM_CONTEXT=8192
FORTE_GPU_LAYERS=99
FORTE_VLM_CPU_PROJECTOR=0
# FORTE_LLAMA_SERVER=/absolute/path/to/llama-server
# FORTE_MODEL_PATH=/absolute/path/to/model.gguf
# FORTE_MMPROJ_PATH=/absolute/path/to/matching-mmproj.gguf
# FORTE_FFMPEG=/absolute/path/to/ffmpeg
# FORTE_FFPROBE=/absolute/path/to/ffprobe
# FORTE_OBJECT_PYTHON=/absolute/path/to/.venv-perception/bin/python
# Never commit API keys. With no override a fresh private key is generated in data/api-key.txt.
